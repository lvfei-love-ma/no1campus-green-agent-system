# 绿知助手环境变量示例
# 复制为 .env 后填入自己的本地值，不要把 .env 提交到版本库。
# 本文件中的值全部是占位符，不是真实凭据。

# ---------------------------------------------------------------- 模型
# 通义千问（DashScope OpenAI 兼容接口）
QWEN_MODEL_NAME=qwen-plus
QWEN_API_KEY=sk-please-replace-with-your-own-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDINGS_MODEL_NAME=text-embedding-v4

# ---------------------------------------------------------------- 邮件验证码
# 使用邮箱的 SMTP 授权码，不要填登录密码
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_account@example.com
SMTP_PASSWORD=your-smtp-authorization-code

# ---------------------------------------------------------------- Redis
# 仅用于登录验证码与发送冷却；历史会话保存在 SQLite
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- 可选配置
# 登录态有效期（小时）
SESSION_TTL_HOURS=168
# 验证码有效期与重发冷却（秒）
VCODE_TTL_SECONDS=300
VCODE_COOLDOWN_SECONDS=60
# 短期记忆：最近 N 轮、单条截断、总长度上限
MEMORY_TURNS=5
MEMORY_MESSAGE_CHARS=600
MEMORY_TOTAL_CHARS=3000
# 检索条数
RETRIEVE_TOP_K=5
# 历史库位置（默认项目内 data/app.db）
# DATA_DIR=./data
# HISTORY_DB_PATH=./data/app.db
# 演示账号登录：仅本地体验，正式部署设为 0
DEMO_LOGIN_ENABLED=1
DEMO_ACCOUNT_A=student_a@demo.local
DEMO_ACCOUNT_B=student_b@demo.local
