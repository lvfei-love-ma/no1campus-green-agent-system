<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>会话 - RAG 智能问答</title>
  <link rel="stylesheet" href="lib/element.css" />
  <link rel="stylesheet" href="lib/github-dark.min.css" />
  <style>
    html, body { margin: 0; height: 100%; font-family: "Helvetica Neue", "PingFang SC", "Microsoft YaHei", Arial, sans-serif; background: #f5f7fa; }
    #app { height: 100%; }
    .layout { height: 100vh; display: flex; flex-direction: column; }
    .chat-header { display: flex; align-items: center; justify-content: space-between; background: #fff; border-bottom: 1px solid #e4e7ed; box-shadow: 0 1px 4px rgba(0, 21, 41, 0.06); padding: 0 20px; height: 56px; }
    .chat-header .title { font-size: 18px; font-weight: 600; color: #303133; }
    .chat-header .user-info { font-size: 13px; color: #606266; margin-right: 16px; }
    .chat-main { flex: 1; overflow-y: auto; padding: 24px 0; background: #f5f7fa; }
    .msg-list { max-width: 860px; margin: 0 auto; padding: 0 16px; }
    .msg-row { display: flex; margin-bottom: 22px; }
    .msg-row.user { flex-direction: row-reverse; }
    .avatar { flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 14px; font-weight: 600; }
    .msg-row.assistant .avatar { background: #409eff; margin-right: 12px; }
    .msg-row.user .avatar { background: #67c23a; margin-left: 12px; }
    .bubble { max-width: 78%; padding: 12px 16px; border-radius: 10px; line-height: 1.7; font-size: 14px; word-break: break-word; }
    .msg-row.assistant .bubble { background: #fff; border: 1px solid #e4e7ed; border-top-left-radius: 2px; }
    .msg-row.user .bubble { background: #ecf5ff; border: 1px solid #d9ecff; color: #303133; border-top-right-radius: 2px; }
    .tool-tip { color: #909399; font-size: 13px; }
    .error-tip { color: #f56c6c; font-size: 13px; }
    .cursor { display: inline-block; margin-left: 2px; color: #409eff; animation: blink 1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    .empty-state { text-align: center; color: #909399; margin-top: 120px; }
    .empty-state p { margin-top: 14px; font-size: 14px; }
    .chat-footer { background: #fff; border-top: 1px solid #e4e7ed; padding: 14px 16px; }
    .input-bar { max-width: 860px; margin: 0 auto; display: flex; gap: 10px; align-items: stretch; }
    .input-bar .el-textarea { flex: 1; }
    .input-bar .el-button { height: auto; align-self: stretch; margin: 0; padding-left: 22px; padding-right: 22px; }
    .md-body :first-child { margin-top: 0; }
    .md-body :last-child { margin-bottom: 0; }
    .md-body h1, .md-body h2, .md-body h3, .md-body h4 { margin: 16px 0 10px; font-weight: 600; line-height: 1.35; }
    .md-body h1 { font-size: 22px; } .md-body h2 { font-size: 19px; } .md-body h3 { font-size: 16px; }
    .md-body p { margin: 8px 0; }
    .md-body ul, .md-body ol { padding-left: 24px; margin: 8px 0; }
    .md-body li { margin: 4px 0; }
    .md-body blockquote { margin: 10px 0; padding: 6px 14px; color: #6a737d; border-left: 4px solid #dfe2e5; background: #f6f8fa; border-radius: 0 4px 4px 0; }
    .md-body code { padding: 2px 6px; font-size: 13px; font-family: Consolas, Monaco, monospace; background: #f0f2f5; color: #c7254e; border-radius: 4px; }
    .md-body pre { margin: 10px 0; padding: 14px 16px; background: #0d1117; border-radius: 8px; overflow-x: auto; line-height: 1.5; }
    .md-body pre code { padding: 0; background: transparent; color: #e6edf3; border-radius: 0; white-space: pre; }
    .md-body table { border-collapse: collapse; margin: 12px 0; width: 100%; font-size: 13px; }
    .md-body th, .md-body td { border: 1px solid #dfe2e5; padding: 8px 12px; text-align: left; }
    .md-body th { background: #f6f8fa; font-weight: 600; }
  </style>
</head>
<body>
  <div id="app">
    <el-container class="layout">
      <el-header class="chat-header" height="56px">
        <div class="title"><i class="el-icon-chat-dot-round"></i> RAG 智能问答</div>
        <div>
          <span class="user-info"><i class="el-icon-user-solid"></i> {{ user }}</span>
          <el-button type="text" @click="logout">退出登录</el-button>
        </div>
      </el-header>
      <el-main class="chat-main" ref="main" @scroll.native="onScroll">
        <div class="msg-list">
          <div v-if="messages.length === 0">
            <div class="empty-state">
              <p>请输入你的问题，例如：介绍一下知识库中的核心内容</p>
            </div>
          </div>
          <div v-for="(msg, idx) in messages" :key="idx" class="msg-row" :class="msg.role">
            <div class="avatar">{{ msg.role === 'user' ? '我' : 'AI' }}</div>
            <div class="bubble">
              <div v-if="msg.status === 'thinking' || msg.status === 'tool'" class="tool-tip">
                <i class="el-icon-loading"></i> {{ msg.statusText }}
              </div>
              <div v-if="msg.status === 'error'" class="error-tip">
                <i class="el-icon-warning-outline"></i> {{ msg.statusText }}
              </div>
              <div class="md-body" v-show="msg.content" v-html="renderMarkdown(msg.content)"></div>
              <span class="cursor" v-if="msg.status === 'streaming'">▍</span>
            </div>
          </div>
        </div>
      </el-main>
      <el-footer class="chat-footer" height="auto">
        <div class="input-bar">
          <el-input v-model="query" type="textarea" :rows="2" resize="none" placeholder="请输入问题，Enter 发送，Shift+Enter 换行" @keydown.enter.native="onEnter"></el-input>
          <el-button type="primary" icon="el-icon-s-promotion" :loading="streaming" :disabled="!query.trim()" @click="send">发送</el-button>
        </div>
      </el-footer>
    </el-container>
  </div>
  <script src="lib/vue.min.js"></script>
  <script src="lib/element.js"></script>
  <script src="lib/axios.min.js"></script>
  <script src="lib/marked.min.js"></script>
  <script src="lib/highlight.min.js"></script>
  <script>
    if (window.marked && window.hljs) {
      marked.setOptions({
        gfm: true,
        breaks: true,
        highlight(code, lang) {
          try {
            if (lang && hljs.getLanguage(lang)) return hljs.highlight(code, { language: lang }).value;
            return hljs.highlightAuto(code).value;
          } catch (e) { return code; }
        }
      });
    }
    new Vue({
      el: '#app',
      data() {
        return {
          user: localStorage.getItem('rag_user') || '',
          query: '',
          messages: [],
          streaming: false,
          source: null,
          stickToBottom: true
        };
      },
      created() {
        if (!this.user) window.location.replace('login.html');
      },
      methods: {
        onEnter(e) {
          if (e.shiftKey) return;
          e.preventDefault();
          this.send();
        },
        send() {
          const q = this.query.trim();
          if (!q || this.streaming) return;
          this.messages.push({ role: 'user', content: q });
          const answer = { role: 'assistant', content: '', status: 'thinking', statusText: '正在思考…' };
          this.messages.push(answer);
          this.query = '';
          this.streaming = true;
          this.stickToBottom = true;
          this.$nextTick(() => this.scrollToBottom(true));
          const es = new EventSource('/api/chat/ask?query=' + encodeURIComponent(q));
          this.source = es;
          es.addEventListener('tool_start', (e) => {
            if (answer.status === 'streaming' || answer.status === 'done') return;
            try {
              const data = JSON.parse(e.data);
              answer.status = 'tool';
              answer.statusText = '正在调用工具：' + data.name + ' …';
              this.$nextTick(() => this.scrollToBottom());
            } catch (err) {}
          });
          es.addEventListener('tool_end', (e) => {
            if (answer.status === 'streaming' || answer.status === 'done') return;
            try {
              const data = JSON.parse(e.data);
              answer.status = 'tool';
              answer.statusText = '工具 ' + data.name + ' 调用完成，正在整理回答…';
              this.$nextTick(() => this.scrollToBottom());
            } catch (err) {}
          });
          es.addEventListener('answer', (e) => {
            if (answer.status === 'done' || answer.status === 'error') return;
            answer.status = 'streaming';
            answer.statusText = '';
            answer.content += e.data;
            this.$nextTick(() => this.scrollToBottom());
          });
          es.addEventListener('error', (e) => {
            if (!e.data) {
              if (answer.status === 'done' || answer.status === 'error') return;
              this.$message.error('网络连接异常');
              if (answer.status === 'streaming' || answer.content) {
                answer.status = 'done';
                answer.statusText = '';
              } else {
                answer.status = 'error';
                answer.statusText = '连接中断，请重试';
              }
              this.finish();
              return;
            }
            try {
              const data = JSON.parse(e.data);
              if (answer.content) {
                answer.status = 'done';
                answer.content += '\n\n**服务异常：** ' + (data.message || '未知错误');
              } else {
                answer.status = 'error';
                answer.statusText = '服务异常：' + (data.message || '未知错误');
              }
            } catch (err) {}
          });
          es.addEventListener('done', () => {
            if (answer.status === 'error') { this.finish(); return; }
            answer.status = 'done';
            answer.statusText = '';
            if (!answer.content) answer.content = '（未返回内容）';
            this.finish();
            this.$nextTick(() => this.scrollToBottom());
          });
        },
        finish() {
          this.streaming = false;
          if (this.source) { this.source.close(); this.source = null; }
        },
        logout() {
          this.$confirm('确定退出登录吗？', '提示', { type: 'warning' }).then(() => {
            localStorage.removeItem('rag_user');
            window.location.href = 'login.html';
          }).catch(() => {});
        },
        renderMarkdown(text) {
          if (!text) return '';
          if (window.marked) {
            try { return marked.parse ? marked.parse(text) : marked(text); } catch (e) {}
          }
          return this.escapeHtml(text).replace(/\n/g, '<br>');
        },
        escapeHtml(s) {
          return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        },
        scrollToBottom(force) {
          const comp = this.$refs.main;
          const el = comp && (comp.$el || comp);
          if (!el) return;
          if (!force && !this.stickToBottom) return;
          el.scrollTop = el.scrollHeight;
        },
        onScroll() {
          const comp = this.$refs.main;
          const el = comp && (comp.$el || comp);
          if (!el) return;
          this.stickToBottom = el.scrollHeight - el.scrollTop - el.clientHeight < 80;
        }
      }
    });
  </script>
</body>
</html>
